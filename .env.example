# Copy to apps/api/.env and fill in the values. Do not commit that file.
#   cp .env.example apps/api/.env

# Neon Postgres. DATABASE_URL is the pooled host (the hostname contains -pooler).
# DIRECT_URL is the direct host, used by Prisma migrations. Both need sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@ep-EXAMPLE.REGION.aws.neon.tech/neondb?sslmode=require
PORT=3000
DEV_USER_EMAIL=dev@localhost

# Study calls post to OpenRouter. The key is sent as Authorization: Bearer.
# The model is google/gemma-4-31b-it:free. A Google Generative Language URL
# is rewritten to this host, so the call does not use generativelanguage.googleapis.com.
# Free tiers are rate-limited and may retain prompts. Check the provider
# terms before sending real user notes.
LLM_PROVIDER=openai
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-31b-it:free
LLM_TIMEOUT_MS=45000
# object sends response_format json_object for non-Gemma models. Gemma requests
# are only a user message: no system role, response_format, max_tokens, or
# temperature. Zod still checks the reply.
LLM_JSON_MODE=object

# Other OpenAI-compatible backends, swap the three settings above:
# Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1
# OpenAI: LLM_BASE_URL=https://api.openai.com/v1
#
# LLM_PROVIDER=fake builds a local study pack and does not call the network.

# Cloudflare R2, S3-compatible. Leave all four blank to run text notes without file storage.
# PDF and image uploads fail until every value is set. The endpoint looks like
# https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
